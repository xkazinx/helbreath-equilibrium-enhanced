[PatchIP]


// use LAN if you are hosting and playing in the same pc
// use INTERNET if you are connecting to an external server
game-server-mode    = INTERNET

// log-server-address must be internal for LAN and external for INTERNET
log-server-address  = 192.168.0.86
log-server-port     = 2981

debug-mouse = 0
windowed = 0
new-resolution = 1